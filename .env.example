# Copy to .env at the repository root (server reads ../../.env) or into server/.env.
# Never commit a real .env file. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
# Explicit demo flag. The `npm run demo` harness sets this automatically and never uses the main .env database.
DEMO_MODE=false
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fabfoods
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Auth. ACCESS_TOKEN_SECRET and REFRESH_TOKEN_PEPPER must be unique, >= 32 chars.
ACCESS_TOKEN_SECRET=development-only-access-secret-change-me-now
REFRESH_TOKEN_PEPPER=development-only-refresh-pepper-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Cookies. COOKIE_SECURE=true is required outside development and test.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

RATE_LIMIT_DISABLED=false
LOG_LEVEL=info

# Admin bootstrap script (npm run create-admin). Never commit real values.
# In production, set ALLOW_ADMIN_BOOTSTRAP=true only while creating the account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_ADMIN_BOOTSTRAP=false

# Payments. Keep disabled until the provider contract and credentials are ready.
# PAYMENT_PROVIDER=disabled|flutterwave
PAYMENT_PROVIDER=disabled
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_REDIRECT_URL=

# Email delivery. The outbox is always written; delivery stays off by default.
EMAIL_DELIVERY_ENABLED=false
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Fabs Restaurant
EMAIL_OUTBOX_BATCH_SIZE=20

# Cloudinary menu image management. Leave all three credentials empty to disable uploads.
# The server signs uploads and deletes; never expose CLOUDINARY_API_SECRET to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=fab-foods/menu
